# ============================================================================
# 環境変数サンプル（このファイルはコミットする）
# 実際の値は .env にコピーして設定する（.env は gitignore 対象）
#
# プレフィックス: ASSET_ALLOC__
#   例: ASSET_ALLOC__PORT=9000  →  settings.port を上書き
# ============================================================================

# --- アプリ ---
ASSET_ALLOC__APP_ENV=development
ASSET_ALLOC__PORT=8000
ASSET_ALLOC__LOG_LEVEL=INFO

# --- データ・出力ディレクトリ（backend/ から見た相対パス） ---
ASSET_ALLOC__DATA_ROOT=../data
ASSET_ALLOC__OUTPUT_ROOT=../outputs
# SQLite 索引 DB。未指定なら DATA_ROOT 配下に app.db が作られる
# ASSET_ALLOC__SQLITE_PATH=../data/app.db
# 資産セット（モード）→ 資産マッピング設定ファイル（JSON の辞書）
# ASSET_ALLOC__ASSET_MAPPING_FILES={"us": "./app/config/assets.default.json", "jp": "./app/config/assets.jp.json"}
# 既定の資産セット（us=米国モード / jp=日本モード）
# ASSET_ALLOC__DEFAULT_ASSET_SET=us

# --- 通貨・FX 方針（初期版の基本方針） ---
ASSET_ALLOC__PORTFOLIO_BASE_CURRENCY=JPY
ASSET_ALLOC__INSTRUMENT_TRADING_CURRENCY=USD
ASSET_ALLOC__UNDERLYING_CURRENCY_EXPOSURE=USD
ASSET_ALLOC__FX_POLICY=unhedged

# --- データ正規化 ---
ASSET_ALLOC__PRICE_MAX_STALENESS_DAYS=5
ASSET_ALLOC__ANNUALIZATION_FACTOR=252

# --- CORS（ローカル開発のみ。ネットワーク公開時は認証等を別途設計） ---
# ASSET_ALLOC__CORS_ORIGINS=["http://localhost:5173"]

# --- 予約: 実データプロバイダーの API キー（絶対にコミットしない） ---
# ASSET_ALLOC__PROVIDER_API_KEY=
